# AWS 자격증명 (boto3 기본 자격증명 체인용) — 값은 비워서 커밋한다.
# 실제 값을 채운 뒤 파일명을 .env로 복사해서 로컬에서만 사용할 것 (.env는 .gitignore 처리됨).
#
# 로컬 개발 시엔 IAM 사용자 Access Key를 채우면 되고, 배포 환경(EC2/ECS 등)에서는
# IAM Role을 쓰는 게 더 안전하니 비워두면 된다 — 그 경우 boto3가 이 값들을 무시하고
# Role 자격증명을 자동으로 사용한다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2

# S3 버킷 override (선택 — 비우면 config.yaml의 data.s3_bucket을 사용)
S3_BUCKET=
