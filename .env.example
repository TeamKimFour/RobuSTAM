# AWS 자격증명 (boto3 기본 자격증명 체인용) — 값은 비워서 커밋한다.
# 실제 값을 채운 뒤 파일명을 .env로 복사해서 로컬에서만 사용할 것 (.env는 .gitignore 처리됨).
#
# 로컬 개발 시엔 IAM 사용자 Access Key를 채우면 되고, 배포 환경(EC2/ECS 등)에서는
# IAM Role을 쓰는 게 더 안전하니 비워두면 된다 — 그 경우 boto3가 이 값들을 무시하고
# Role 자격증명을 자동으로 사용한다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2

# S3 버킷 override (data 파이프라인엔 선택 — 비우면 config.yaml의 data.s3_bucket 사용.
#                  MLflow docker compose 실행 시엔 필수 — 비우면 아티팩트 업로드 URI가 무효).
S3_BUCKET=

# ─── MLflow 트래킹 서버 (docker compose up mlflow) ───
# 아래 값 없이 서버를 띄우면 컨테이너가 SQLite로 조용히 폴백돼서 팀 공용 DB에
# 붙지 않는다(에러 대신 침묵). 팀 실험 공유하려면 반드시 채울 것.

# Render Postgres 연결 문자열. 팀 vault에서 External Database URL 받아 채운다.
# 반드시 뒤에 ?sslmode=require를 붙일 것 (Render는 SSL 강제).
DATABASE_URL=

# MLflow 서버 포트 (기본 5000)
PORT=5000

# 파이썬 stdout 즉시 플러시 (docker logs 실시간 확인용)
PYTHONUNBUFFERED=1
