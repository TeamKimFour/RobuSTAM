# RobuSTAM FastAPI 추론 서버 이미지
# 로컬·CI와 동일한 Python 3.12 + 핀 의존성으로 어디서든 재현 실행.
# src/api/는 현재 헬스체크 placeholder — 도현의 실제 추론 코드로 교체돼도
# 이 Dockerfile은 그대로 재사용 가능(uvicorn 실행 대상만 동일).
#
# 사용:
#   docker build -t robustam-api -f docker/Dockerfile.api .
#   docker run -p 8000:8000 robustam-api
FROM python:3.12-slim

WORKDIR /app

# 1) 의존성 먼저 설치 (레이어 캐시 활용)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 2) 실행에 필요한 소스·설정만 복사 (data/·tests/·docs/ 제외)
COPY config/ ./config/
COPY src/ ./src/
COPY docker/api_entrypoint.sh ./api_entrypoint.sh
RUN chmod +x ./api_entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["./api_entrypoint.sh"]
