FROM python:3.12-slim
WORKDIR /app
COPY requirements-mlflow.txt .
RUN pip install --no-cache-dir -r requirements-mlflow.txt
EXPOSE 5000
CMD mlflow server \
    --host 0.0.0.0 \
    --port ${PORT:-5000} \
    --backend-store-uri "$DATABASE_URL" \
    --artifacts-destination s3://${S3_BUCKET}/mlflow-artifacts
