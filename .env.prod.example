# RobuSTAM 프로덕션 배포용 환경변수 — 값은 비워서 커밋한다.
# 실제 값을 채운 뒤 파일명을 .env.prod로 복사해서 배포 서버에서만 사용할 것
# (.env.prod는 .gitignore 처리됨).

# Cloudflare Zero Trust 대시보드에서 Tunnel 생성 후 발급되는 토큰.
# TODO: 실제 도메인 확정 후 Public Hostname 라우팅을 대시보드에서 fastapi:8000으로 설정.
CLOUDFLARE_TUNNEL_TOKEN=

# latest.json S3 동기화(src/inference/s3_fetch.py) — 비우면 config.yaml의
# data.s3_bucket/data.s3_prefix를 그대로 쓴다. 보통은 비워둬도 된다.
S3_BUCKET=
S3_PREFIX=
PRECOMPUTE_SYNC_INTERVAL_SEC=300

# AWS 자격증명 — EC2 등에 IAM Role(인스턴스 프로파일)이 붙어 있다면 비워두는 게 더 안전
# (boto3가 Role 자격증명을 자동 사용). Role을 못 쓰는 환경에서만 채운다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
