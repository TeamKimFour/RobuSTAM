# RobuSTAM 프론트엔드 환경변수
# 실행 전 `.env.local`로 복사해서 값을 채운다.

# FastAPI 추론 서버 베이스 URL (src/api/main.py). uvicorn 기본 포트는 8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 백테스트 실데이터 JSON 원격 URL (Vercel prebuild가 다운로드).
# 백엔드가 `python -m src.backtest.export --upload-s3`로 올린 S3 객체를 가리킨다.
# 예: https://robustam-teamkimfour.s3.ap-northeast-2.amazonaws.com/robustam/frontend/backtest.json
# 미설정 시 조용히 skip → loader.ts가 mock으로 fallback (로컬 개발엔 이대로 두면 됨).
BACKTEST_JSON_URL=
